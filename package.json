{
  "name": "solana-amm-defi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{ts,js,json}\"",
    "test": "anchor test",
    "test:unit": "cargo test --manifest-path programs/amm/Cargo.toml",
    "setup:devnet": "ts-node scripts/setup-devnet.ts",
    "build:docker": "docker build -f Dockerfile.build -t solana-amm-builder:0.30.1 .",
    "anchor:build": "docker run --rm -v \"%cd%\":/work -w /work solana-amm-builder:0.30.1 bash -lc \"anchor build\"",
    "anchor:test": "docker run --rm -v \"%cd%\":/work -w /work solana-amm-builder:0.30.1 bash -lc \"anchor test\""
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.1",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "prettier": "^3.4.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
